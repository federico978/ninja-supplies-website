---
import Figure from './Figure.astro';
import SectionHead from './SectionHead.astro';
import { systems } from '../data/content';

import modularUnits from '../assets/images/modular-units-detail.jpg';
import powerModule from '../assets/images/power-module-detail.jpg';
import immersionDetail from '../assets/images/immersion-cooling-detail.jpg';
import siteAccess from '../assets/images/site-access-detail.jpg';

/* Purpose-made crops per system, so each panel shows a distinct frame rather
   than the same wide view five times. Keyed by system code. */
const panelImage: Record<string, ImageMetadata> = {
  MDC: modularUnits,
  PWR: powerModule,
  CLG: immersionDetail,
  LOG: siteAccess,
  INT: systems.entries[4].image as ImageMetadata,
};

type ImageMetadata = import('astro').ImageMetadata;
---

<section id="systems" class="section systems" aria-labelledby="systems-title">
  <div class="wrap">

    <SectionHead
      index={systems.index}
      eyebrow={systems.eyebrow}
      title={systems.title}
      lede={systems.lede}
      id="systems-title"
    >
      <div slot="lede-extra" class="legend">
        <p class="label legend__note">{systems.legend}</p>
        <ul class="legend__keys">
          {systems.entries.map((e) => (
            <li><b>{e.code}</b><span>{e.short}</span></li>
          ))}
        </ul>
      </div>
    </SectionHead>

    <ol class="sys" id="sys">
      {systems.entries.map((entry, i) => (
        <li
          class:list={['sys__row', 'rv', { 'is-open': i === 0 }]}
          data-code={entry.code}
          data-deps={entry.dependsOn.join(' ')}
        >
          <button class="sys__head" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`panel-${entry.code}`}>
            <span class="sys__code">{entry.code}</span>
            <span class="sys__name">{entry.name}</span>
            <span class="sys__summary">{entry.summary}</span>
            <span class="sys__deps">
              <span class="label">Integrates with</span>
              <span class="sys__codes">
                {entry.dependsOn.map((d) => <b>{d}</b>)}
              </span>
            </span>
            <span class="sys__toggle" aria-hidden="true"></span>
          </button>

          <div class="sys__panel" id={`panel-${entry.code}`}>
            <div class="sys__panel-inner">
              <div class="sys__body">
                <div class="sys__fig">
                  <Figure
                    src={panelImage[entry.code] ?? entry.image}
                    alt={entry.imageAlt}
                    caption={entry.imageCaption}
                    temp={entry.imageIsTemp ?? false}
                    position={entry.imagePosition}
                    sizes="(max-width: 900px) 100vw, 34vw"
                    widths={[480, 720, 1000, 1400]}
                  />
                </div>
                <div class="sys__detail">
                  <div>
                    <p class="label">Covers</p>
                    <ul class="sys__covers">
                      {entry.covers.map((c) => <li>{c}</li>)}
                    </ul>
                  </div>
                  <div>
                    <p class="label">Why it constrains the others</p>
                    <p class="sys__dependency">{entry.dependency}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .systems {
    background: linear-gradient(180deg, var(--limestone) 0%, var(--paper) 42%, var(--limestone) 100%);
    border-top: 1px solid var(--hairline);
  }

  /* --- Code legend: makes the codes readable without hovering ---------- */
  .legend {
    margin-top: 1.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--hairline);
  }
  .legend__note { line-height: 1.7; margin-bottom: 1.1rem; }
  .legend__keys { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; }
  .legend__keys li { display: inline-flex; align-items: baseline; gap: 0.5rem; }
  .legend__keys b {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--copper-text);
  }
  .legend__keys span { font-size: 0.8125rem; color: var(--ink-3); }

  /* --- Rows ------------------------------------------------------------ */
  .sys { border-top: 1px solid var(--hairline-firm); }
  .sys__row { border-bottom: 1px solid var(--hairline); position: relative; }

  .sys__row::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--gutter) * 0.5);
    top: 0; bottom: 0;
    width: 3px;
    background: var(--copper);
    opacity: 0;
    transition: opacity 280ms var(--ease);
  }
  .sys__row.is-linked::before { opacity: 1; }

  .sys__head {
    width: 100%;
    display: grid;
    grid-template-columns: 104px minmax(240px, 1.1fr) minmax(260px, 1.05fr) 236px 36px;
    align-items: start;
    column-gap: var(--gap);
    text-align: left;
    /* generous vertical rhythm — the section must not read as a table */
    padding: clamp(2.4rem, 3.6vw, 3.4rem) 0;
    cursor: pointer;
    transition: opacity 280ms var(--ease);
  }

  .sys__code {
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--copper-text);
    padding-top: 0.7rem;
  }

  .sys__name {
    font-size: var(--fs-h3);
    line-height: 1.06;
    letter-spacing: -0.019em;
    font-weight: 600;
    color: var(--ink-1);
    text-wrap: balance;
  }

  .sys__summary {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-2);
    padding-top: 0.4rem;
    max-width: 44ch;
  }

  .sys__deps { padding-top: 0.6rem; }
  .sys__deps :global(.label) { display: block; margin-bottom: 0.7rem; }
  .sys__codes { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .sys__codes b {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    border: 1px solid var(--hairline-firm);
    padding: 0.28rem 0.5rem;
    transition: color 280ms var(--ease), border-color 280ms var(--ease), background 280ms var(--ease);
  }
  .sys__row:hover .sys__codes b,
  .sys__row.is-open .sys__codes b {
    color: var(--copper-text);
    border-color: var(--copper);
  }

  .sys__toggle {
    position: relative;
    width: 24px; height: 24px;
    justify-self: end;
    margin-top: 0.6rem;
  }
  .sys__toggle::before,
  .sys__toggle::after {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    width: 24px; height: 1px;
    background: var(--ink-1);
    transition: transform 380ms var(--ease);
  }
  .sys__toggle::after { transform: rotate(90deg); }
  .sys__row.is-open .sys__toggle::after { transform: rotate(0deg); }

  /* --- Panel ----------------------------------------------------------- */
  .sys__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 440ms var(--ease);
  }
  .sys__row.is-open .sys__panel { grid-template-rows: 1fr; }
  .sys__panel-inner { overflow: hidden; }

  .sys__body {
    display: grid;
    grid-template-columns: 104px minmax(240px, 1.1fr) minmax(260px, 1.05fr) 236px 36px;
    column-gap: var(--gap);
    padding-bottom: clamp(2.4rem, 3.8vw, 3.4rem);
  }
  .sys__fig { grid-column: 2 / 3; }
  .sys__fig :global(.fig) { aspect-ratio: 16 / 10; }
  .sys__detail {
    grid-column: 3 / 5;
    display: grid;
    gap: 2rem;
    align-content: start;
  }
  .sys__detail :global(.label) { display: block; margin-bottom: 0.8rem; }

  .sys__covers { columns: 2; column-gap: var(--gap); }
  .sys__covers li {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--ink-2);
    padding: 0.48rem 0;
    border-top: 1px solid var(--hairline-soft);
    break-inside: avoid;
  }

  .sys__dependency {
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--ink-1);
    border-left: 2px solid var(--copper);
    padding-left: 1.2rem;
    max-width: 52ch;
  }

  /* Dependency probe: dim everything the hovered row does not constrain. */
  .sys.is-probing .sys__row:not(.is-linked):not(.is-hovered) .sys__head { opacity: 0.4; }

  @media (max-width: 1180px) {
    .sys__head, .sys__body { grid-template-columns: 84px minmax(200px, 1fr) 210px 30px; }
    .sys__name { grid-column: 2 / 3; }
    .sys__summary { grid-column: 2 / 3; padding-top: 1rem; max-width: 54ch; }
    .sys__deps { grid-column: 3 / 4; }
    .sys__toggle { grid-column: 4 / 5; }
    .sys__fig { grid-column: 2 / 3; }
    .sys__detail { grid-column: 3 / 5; }
    .sys__covers { columns: 1; }
  }

  @media (max-width: 900px) {
    .sys__head {
      grid-template-columns: 1fr 30px;
      row-gap: 1rem;
      padding: 1.9rem 0;
    }
    .sys__code { grid-column: 1 / 2; padding-top: 0; }
    .sys__toggle { grid-column: 2 / 3; grid-row: 1 / 2; margin-top: 0; }
    .sys__name { grid-column: 1 / 3; }
    .sys__summary { grid-column: 1 / 3; padding-top: 0; max-width: none; }
    .sys__deps { grid-column: 1 / 3; padding-top: 0.3rem; }

    .sys__body { display: block; padding-bottom: 2.2rem; }
    .sys__fig {
      margin-inline: calc(-1 * var(--gutter));
      width: calc(100% + var(--gutter) * 2);
    }
    .sys__fig :global(.fig) { aspect-ratio: 3 / 2; }
    .sys__detail { margin-top: 1.8rem; gap: 1.6rem; }
    .sys__dependency { font-size: 1.0625rem; }
    .sys__row::before { left: calc(-1 * var(--gutter)); }
    .sys.is-probing .sys__row:not(.is-linked):not(.is-hovered) .sys__head { opacity: 1; }
  }
</style>

<script>
  const list = document.getElementById('sys');
  if (list) {
    const rows = Array.from(list.querySelectorAll<HTMLLIElement>('.sys__row'));
    const byCode = new Map(rows.map((r) => [r.dataset.code ?? '', r]));

    const clear = () => {
      list.classList.remove('is-probing');
      rows.forEach((r) => r.classList.remove('is-linked', 'is-hovered'));
    };

    const probe = (row: HTMLLIElement) => {
      clear();
      list.classList.add('is-probing');
      row.classList.add('is-hovered');
      (row.dataset.deps ?? '').split(/\s+/).forEach((code) => {
        byCode.get(code)?.classList.add('is-linked');
      });
    };

    rows.forEach((row) => {
      const head = row.querySelector<HTMLButtonElement>('.sys__head');
      if (!head) return;

      head.addEventListener('click', () => {
        const open = row.classList.toggle('is-open');
        head.setAttribute('aria-expanded', open ? 'true' : 'false');
      });

      row.addEventListener('mouseenter', () => probe(row));
      row.addEventListener('mouseleave', clear);
      head.addEventListener('focus', () => probe(row));
      head.addEventListener('blur', clear);
    });
  }
</script>
