---
import Figure from './Figure.astro';
import { position } from '../data/content';
import processVessels from '../assets/images/process-vessels-detail.jpg';
---

<section id="position" class="section surface-sand pos" aria-labelledby="position-title">
  <div class="wrap grid12">
    <p class="label pos__eyebrow rv">
      <span class="mark" aria-hidden="true"></span>{position.index} / {position.eyebrow}
    </p>

    <h2 id="position-title" class="pos__statement rv rv-1">
      {position.statement.map((line) => <span>{line}</span>)}
    </h2>

    <div class="pos__col rv rv-2">
      {position.body.map((para) => <p class="pos__para">{para}</p>)}

      <aside class="pos__aside">
        <p class="label">{position.aside.label}</p>
        <p class="pos__aside-text">{position.aside.text}</p>
      </aside>
    </div>

    <div class="pos__media rv rv-3">
      <Figure
        src={processVessels}
        alt={position.imageAlt}
        caption={position.imageCaption}
        temp={false}
        position="46% 64%"
        sizes="(max-width: 1020px) 100vw, 34vw"
        widths={[420, 640, 900, 1350]}
      />
    </div>
  </div>
</section>

<style>
  .pos__eyebrow { grid-column: 1 / 13; margin-bottom: 2.4rem; display: flex; align-items: center; }

  .pos__statement {
    grid-column: 1 / 10;
    font-size: clamp(1.6rem, 2.9vw, 2.6rem);
    line-height: 1.14;
    letter-spacing: -0.018em;
    font-weight: 500;
    color: var(--ink-1);
    margin-bottom: clamp(2.5rem, 4.5vw, 3.8rem);
    text-wrap: pretty;
  }
  .pos__statement span { display: block; }
  .pos__statement span:first-child { color: var(--ink-3); }

  .pos__col { grid-column: 1 / 7; }
  .pos__para {
    font-size: var(--fs-lede);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 54ch;
  }
  .pos__para + .pos__para { margin-top: 1.4rem; }

  .pos__aside {
    margin-top: clamp(2.2rem, 4vw, 3rem);
    border-top: 2px solid var(--copper);
    padding-top: 1.2rem;
  }
  .pos__aside-text {
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ink-1);
    font-weight: 500;
    max-width: 44ch;
  }

  /* Crop set here, not via the component's `ratio` prop: that writes an inline
     style, which a media query cannot override. */
  .pos__media { grid-column: 8 / 13; align-self: start; }
  .pos__media :global(.fig) { aspect-ratio: 4 / 5; }

  @media (max-width: 1020px) {
    .pos__statement { grid-column: 1 / 13; }
    .pos__col { grid-column: 1 / 13; }
    .pos__para { max-width: 62ch; }
    .pos__media { grid-column: 1 / 13; margin-top: clamp(2.5rem, 5vw, 3.5rem); }
    .pos__media :global(.fig) { aspect-ratio: 16 / 9; }
  }
</style>
