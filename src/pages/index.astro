---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Position from '../components/Position.astro';
import Systems from '../components/Systems.astro';
import Method from '../components/Method.astro';
import Environments from '../components/Environments.astro';
import Infrastructure from '../components/Infrastructure.astro';
import Approach from '../components/Approach.astro';
import Leadership from '../components/Leadership.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />

  <main id="main">
    <Hero />
    <Position />
    <Systems />
    <Method />
    <Environments />
    <Infrastructure />
    <Approach />
    <Leadership />
    <Contact />
  </main>

  <Footer />
</Base>
