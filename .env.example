# ---------------------------------------------------------------------------
# Ninja Supplies — environment
#
# Copy to `.env` and fill in once the production domain has been selected.
# Leave empty until then. Nothing in the build guesses a domain.
# ---------------------------------------------------------------------------

# Absolute production URL, including protocol and no trailing slash.
# Example once chosen:  PUBLIC_SITE_URL=https://example.com
#
# While this is empty the build deliberately omits:
#   - the canonical <link>
#   - og:url and twitter metadata that require an absolute URL
#   - sitemap-index.xml (the @astrojs/sitemap integration is not loaded)
#   - the Sitemap: line in robots.txt
#
# Everything else builds and deploys normally.
PUBLIC_SITE_URL=
